# Все секреты — только серверные. В Vercel добавляются в Project Settings → Environment Variables.
# Для AI Gateway: LLM_PROVIDER=vercel и LLM_MODEL=creator/model.
# На Vercel используется автоматический OIDC; вне Vercel можно задать AI_GATEWAY_API_KEY.
# Модель выбирается после проверки Free Tier в вашем аккаунте. Базовый URL задаётся автоматически.
LLM_PROVIDER=generic
# Для Groq Free: LLM_PROVIDER=groq, GROQ_API_KEY и явный LLM_MODEL.
# Endpoint закреплён за https://api.groq.com/openai/v1, Vercel OIDC не используется.
# Указывайте модель, доступную именно вашему аккаунту; платный тариф не включайте.
GROQ_API_KEY=
# generated включает генерацию реплик; rules сохраняет подготовленные ответы.
LLM_REPLY_MODE=rules
AI_GATEWAY_API_KEY=
# Для другого совместимого провайдера: LLM_PROVIDER=generic и три значения ниже.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Для Vercel обязательна постоянная PostgreSQL-база (например, Neon Free).
# Строка подключения берётся из панели базы, включая рекомендуемые параметры TLS.
DATABASE_URL=
# SQLite используется только локально, когда DATABASE_URL не задан.
# DB_PATH=backend/data/sessions.sqlite3
# На Vercel secure-cookie включается автоматически.
# COOKIE_SECURE=1
