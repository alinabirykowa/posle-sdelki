{
  "name": "posle-sdelki-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
